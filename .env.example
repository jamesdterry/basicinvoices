# Required (production fail-fast)
SUPER_ADMIN_EMAIL=you@example.com
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8080
DB_PATH=./data/basicinvoices.sqlite

# Optional
PORT=8080
LOG_LEVEL=debug
NODE_ENV=development

# Optional: SMTP (omit to log magic-link URLs to stdout)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Basic Invoices <noreply@example.com>"

# Optional: Stripe Payment Links (Stage 7A). Without this the Generate-link
# button is hidden and manual paste of a Payment Link URL is the fallback.
# STRIPE_SECRET_KEY=sk_test_...

# Optional: TOTP secret for the GitHub Actions cron trigger (Stage 8.5).
# Generate with `openssl rand -hex 20`. Must match the GitHub repo secret
# of the same name. When unset, /cron/recurring-tick returns 503 and the
# tick relies on wake-on-activity (/api/me) only. See DEPLOY.md.
# RECURRING_TICK_SECRET=

# Optional: Litestream replication target (S3-compatible)
# BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=auto
