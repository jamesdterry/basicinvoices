# Required (production fail-fast)
SUPER_ADMIN_EMAIL=you@example.com
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:8080
DB_PATH=./data/basicinvoices.sqlite

# Optional
PORT=8080
LOG_LEVEL=debug
NODE_ENV=development

# Optional: SMTP (omit to log magic-link URLs to stdout)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Basic Invoices <noreply@example.com>"

# Optional: Litestream replication target (S3-compatible)
# BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=auto
